{
  "name": "atc-sim",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "sim:test": "tsx scripts/sim-test.ts",
    "gameplay:test": "tsx scripts/gameplay-test.ts",
    "planning:test": "tsx scripts/planning-test.ts",
    "challenge:test": "tsx scripts/challenge-test.ts",
    "edge:test": "tsx scripts/edge-audit-test.ts",
    "experience:test": "tsx scripts/experience-test.ts",
    "operations:test": "tsx scripts/operations-test.ts",
    "decisions:test": "tsx scripts/decisions-test.ts",
    "decisions:ui:test": "node scripts/decisions-ui-test.mjs",
    "operations:ui:test": "node scripts/operations-ui-test.mjs",
    "ui:test": "node scripts/ui-test.mjs",
    "planning:ui:test": "node scripts/planning-ui-test.mjs",
    "experience:ui:test": "node scripts/experience-ui-test.mjs",
    "visual:ui:test": "node scripts/visual-ui-test.mjs",
    "accept": "npm run typecheck && npm run sim:test && npm run gameplay:test && npm run planning:test && npm run challenge:test && npm run edge:test && npm run experience:test && npm run operations:test && npm run decisions:test",
    "shot": "node scripts/shot.mjs"
  },
  "dependencies": {
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "three": "^0.186.1"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.186.0",
    "@vitejs/plugin-react": "^6.1.2",
    "puppeteer-core": "^25.14.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.4"
  }
}
